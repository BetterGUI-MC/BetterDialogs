<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>me.hsgamer.bettergui</groupId>
    <artifactId>addon-parent</artifactId>
    <version>4.0</version>
  </parent>

  <artifactId>BetterDialogs</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>BetterDialogs</name>
  <description>Another addon for creating dialogs</description>

  <properties>
    <unidialog.version>1.3.1</unidialog.version>
    <java.version>21</java.version>
    <project.mainClass>me.hsgamer.bettergui.betterdialogs.BetterDialogs</project.mainClass>
  </properties>

  <repositories>
    <repository>
      <id>codemc-public</id>
      <url>https://repo.codemc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <!-- HSCore -->
                <relocation>
                  <pattern>me.hsgamer.hscore</pattern>
                  <shadedPattern>me.hsgamer.bettergui.lib.core</shadedPattern>
                </relocation>

                <!-- MineLib -->
                <relocation>
                  <pattern>io.github.projectunified.minelib</pattern>
                  <shadedPattern>me.hsgamer.bettergui.lib.minelib</shadedPattern>
                </relocation>

                <!-- bStats -->
                <relocation>
                  <pattern>org.bstats</pattern>
                  <shadedPattern>me.hsgamer.bettergui.lib.bstats</shadedPattern>
                </relocation>

                <!-- UniDialog -->
                <relocation>
                  <pattern>io.github.projectunified.unidialog</pattern>
                  <shadedPattern>me.hsgamer.bettergui.betterdialogs.lib.unidialog</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>io.github.projectunified</groupId>
      <artifactId>uni-dialog-packetevents</artifactId>
      <version>${unidialog.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.projectunified</groupId>
      <artifactId>uni-dialog-paper</artifactId>
      <version>${unidialog.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.projectunified</groupId>
      <artifactId>uni-dialog-spigot</artifactId>
      <version>${unidialog.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.retrooper</groupId>
      <artifactId>packetevents-spigot</artifactId>
      <version>2.9.0-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains</groupId>
      <artifactId>annotations</artifactId>
      <version>26.0.2</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
